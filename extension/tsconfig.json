{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["chrome", "node", "vite/client"],
		"strict": true,
		// `noUnusedLocals`/`noUnusedParameters` are deliberately off: the vendored
		// api/ modules carry a few unused imports and must stay byte-identical to
		// frontend/ (see src/lib/VENDORED.md). ESLint covers unused vars in code
		// this package actually owns.
		"noImplicitOverride": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"allowJs": true,
		"checkJs": false,
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.svelte", "test/**/*.ts", "*.config.ts"],
	"exclude": ["node_modules", "dist"]
}
