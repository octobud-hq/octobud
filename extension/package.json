{
    "name": "octobud-extension",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Octobud browser side panel — one saved view at a time",
    "scripts": {
        "dev": "vite",
        "build": "vite build && node scripts/build-manifest.mjs",
        "icons": "node scripts/make-icons.mjs",
        "octicons": "node scripts/build-octicons-subset.mjs",
        "stub": "node dev/stub-server/server.mjs",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "lint": "eslint .",
        "lint:firefox": "web-ext lint --source-dir dist/firefox",
        "format": "prettier --write \"{src,test,dev,scripts}/**/*.{js,mjs,ts,svelte,css,json}\"",
        "format:check": "prettier --check \"{src,test,dev,scripts}/**/*.{js,mjs,ts,svelte,css,json}\"",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.1.18",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/svelte": "^5.3.1",
        "@types/chrome": "^0.0.287",
        "@types/node": "^25.3.5",
        "@typescript-eslint/parser": "^8.58.2",
        "eslint": "^10.0.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.15.1",
        "globals": "^17.11.0",
        "jsdom": "^28.0.0",
        "prettier": "^3.8.1",
        "prettier-plugin-svelte": "^3.4.1",
        "svelte": "^5.55.7",
        "svelte-check": "^4.4.5",
        "tailwindcss": "^4.1.18",
        "tslib": "^2.7.0",
        "typescript": "^5.6.3",
        "vite": "^7.3.2",
        "vitest": "^4.1.0",
        "web-ext": "^8.3.0"
    },
    "dependencies": {
        "@primer/octicons": "^19.22.0"
    }
}
