{
    "name": "octobud-frontend",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "sync:changelog": "node -e \"require('fs').copyFileSync('../CHANGELOG.md', 'static/CHANGELOG.md')\"",
        "predev": "npm run sync:changelog",
        "prebuild": "npm run sync:changelog",
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "lint": "eslint .",
        "format": "prettier --write \"src/**/*.{js,ts,svelte,css,json}\"",
        "format:check": "prettier --check \"src/**/*.{js,ts,svelte,css,json}\"",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@eslint/compat": "^2.0.3",
        "@opentelemetry/api": "^1.9.0",
        "@skeletonlabs/skeleton": "^4.9.0",
        "@sveltejs/adapter-auto": "^3.3.1",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.60.1",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/postcss": "^4.1.18",
        "@tailwindcss/typography": "^0.5.19",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/svelte": "^5.3.1",
        "@types/dompurify": "^3.2.0",
        "@types/node": "^25.3.5",
        "@typescript-eslint/parser": "^8.58.2",
        "autoprefixer": "^10.4.27",
        "eslint": "^10.0.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.15.1",
        "jsdom": "^28.0.0",
        "patch-package": "^8.0.1",
        "postcss": "^8.5.10",
        "prettier": "^3.8.4",
        "prettier-plugin-svelte": "^3.4.1",
        "svelte": "^5.55.7",
        "svelte-check": "^4.4.5",
        "tailwindcss": "^4.1.18",
        "tslib": "^2.7.0",
        "typescript": "^5.6.3",
        "vite": "^7.3.2",
        "vitest": "^4.1.0"
    },
    "dependencies": {
        "@floating-ui/dom": "^1.7.6",
        "@primer/octicons": "^19.22.0",
        "dompurify": "^3.4.0",
        "highlight.js": "^11.11.1",
        "marked": "^17.0.1"
    },
    "overrides": {
        "cookie": "^0.7.1",
        "tmp": "^0.2.6",
        "picomatch": "^4.0.4",
        "micromatch": { "picomatch": "^2.3.2" },
        "flatted": "^3.4.2",
        "undici": "^7.24.0",
        "rollup": "^4.59.0",
        "@sveltejs/vite-plugin-svelte": "^6.2.4"
    }
}
